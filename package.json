{
  "name": "finanzas-personales",
  "private": true,
  "version": "1.0.0",
  "description": "App de control de ingresos y egresos personales, con manejo de cuotas y arrastre automático de gastos fijos entre meses.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch dev-server.ts",
    "dev:local": "concurrently -k -n vite,api -c blue,green \"npm:dev\" \"npm:dev:api\"",
    "dev:full": "vercel dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.4",
    "bcryptjs": "^2.4.3",
    "cookie": "^0.6.0",
    "date-fns": "^3.6.0",
    "jose": "^5.6.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^3.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.3",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.0",
    "typescript": "^5.5.3",
    "vercel": "^37.2.1",
    "vite": "^5.3.3"
  }
}
