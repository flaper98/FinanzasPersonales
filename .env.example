# Cadena de conexión de tu base de datos Postgres (Neon o Vercel Postgres).
# Ver instrucciones en el README, sección "Backend y cuentas de usuario".
DATABASE_URL=

# Secreto para firmar las sesiones (cookies) de login. Generalo vos mismo,
# por ejemplo con: openssl rand -base64 32
JWT_SECRET=

# API key de Resend (resend.com) para enviar el correo de "recuperar contraseña".
# Ver instrucciones en el README, sección "Recuperar contraseña".
RESEND_API_KEY=

# Dirección "de" con la que se envían esos correos (ej. onboarding@resend.dev
# para pruebas, o un correo de tu propio dominio ya verificado en Resend).
EMAIL_FROM=
